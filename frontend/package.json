{
  "name": "deployguard-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "prebuild": "node -e \"require('fs').writeFileSync('lib/build-info.json', JSON.stringify({builtAt: new Date().toISOString()}) + '\\n')\"",
    "postbuild": "node -e \"const fs=require('fs');fs.cpSync('public','.next/standalone/public',{recursive:true});fs.cpSync('.next/static','.next/standalone/.next/static',{recursive:true})\""
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.2.8",
    "@fontsource/instrument-serif": "5.2.8",
    "lucide-react": "0.460.0",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "autoprefixer": "10.4.21",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.35",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.19",
    "typescript": "5.6.3",
    "vitest": "2.1.9"
  }
}
