# Controller
DATA_DIR=data
DG_CONTROLLER_ID=1
HTTP_PORT=8081
GRPC_PORT=9091
PEERS=1=localhost:9091,2=localhost:9092,3=localhost:9093
# Failure detector and election timing (milliseconds)
HEARTBEAT_MS=1000
SUSPECT_AFTER_MS=3000
DISCONNECT_AFTER_MS=8000
STALE_AFTER_MS=4000
LEADER_TIMEOUT_MS=3500

# Agent
DG_AGENT_ID=agent-1
DG_ENV=production
CONTROLLERS=1=localhost:9091,2=localhost:9092,3=localhost:9093
CLOCK_SKEW_MS=random
DG_TRAFFIC_RPS=40

# Dashboard (frontend)
CONTROLLER_URL=http://localhost:8081,http://localhost:8082,http://localhost:8083
NEXT_PUBLIC_SITE_URL=http://localhost:3000
